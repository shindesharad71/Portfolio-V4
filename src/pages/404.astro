---
import MainHead from '../components/MainHead.astro';
import '../styles/global.css';
---
<html lang="en">
  <head>
    <MainHead title="404 — Page not found | Sharad Shinde" />
    <meta name="robots" content="noindex" />
  </head>
  <body>
    <main class="notfound">
      <p class="notfound-code">
        <span class="gradient-text">404</span>
      </p>
      <h1 class="notfound-title">This route doesn't resolve.</h1>
      <p class="notfound-desc">
        Looks like this endpoint returned nothing — even the best systems drop a request now and then.
      </p>
      <pre class="notfound-log">GET {'{path}'} → 404 · retrying at <a href="/">shrd.in</a></pre>
      <a href="/" class="btn btn-primary">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5"/><path d="M12 19l-7-7 7-7"/></svg>
        Back to home
      </a>
    </main>
    <script>
      const log = document.querySelector('.notfound-log');
      if (log) log.innerHTML = log.innerHTML.replace('{path}', location.pathname);
    </script>
  </body>
</html>
<style>
  .notfound {
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: var(--space-6);
  }

  .notfound-code {
    font-family: var(--font-display);
    font-size: clamp(5rem, 20vw, 9rem);
    font-weight: var(--weight-bold);
    line-height: 1;
    margin-bottom: var(--space-4);
  }

  .notfound-title {
    font-size: var(--text-2xl);
    margin-bottom: var(--space-4);
  }

  .notfound-desc {
    max-width: 44ch;
    margin-bottom: var(--space-6);
  }

  .notfound-log {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-text-subtle);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-3) var(--space-5);
    margin-bottom: var(--space-8);
    max-width: 100%;
    overflow-x: auto;
  }
</style>
