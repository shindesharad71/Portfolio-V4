---
import site from "../data/site.json";
const {description, url} = site;
const title = Astro.props.title ?? site.title;
---
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{title}</title>

<!-- Primary Meta Tags -->
<meta name="title" content={title}>
<meta name="description" content={description}>
<meta name="author" content="Sharad Shinde">
<meta name="robots" content="index, follow">
<meta name="keywords" content="Sharad Shinde, Staff Engineer, Backend Engineer, Software Engineer, Full Stack Developer, Node.js, Python, Ruby, Go, System Design">

<!-- Open Graph / Facebook -->
<meta property="og:type" content="website">
<meta property="og:url" content={url}>
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:image" content={`${url}assets/og.jpg`}>
<meta property="og:image:alt" content="Sharad Shinde's Profile Picture">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:locale" content="en_US">
<meta property="og:site_name" content={title}>

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:site" content="@shindesharad71">
<meta name="twitter:creator" content="@shindesharad71">
<meta name="twitter:title" content={title}>
<meta name="twitter:description" content={description}>
<meta name="twitter:image" content={`${url}assets/og.jpg`}>
<meta name="twitter:url" content={url}>

<!-- Verification -->
<meta name="google-site-verification" content="xdqQAL6KCVHCJcgHYDB6DDCnhx3QI6IMeen9BrKTveg">
<meta name="google-site-verification" content="95psw0DXvxCto91NvXCF9AjiNHvWelhIMJ6tdah-FXE">

<!-- Theme -->
<meta name="theme-color" content="#0d2a4c">
<meta name="msapplication-TileColor" content="#0d2a4c">

<!-- Links (fonts are self-hosted via @fontsource, imported in index.astro) -->
<link rel="canonical" href={url}>
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="icon" href="/favicon.ico" sizes="32x32">
<link rel="manifest" href="/manifest.json">

<!-- Structured Data -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "Sharad Shinde",
  "url": "https://shrd.in",
  "image": "https://shrd.in/assets/og.jpg",
  "jobTitle": "Staff Engineer",
  "worksFor": {
    "@type": "Organization",
    "name": "HighLevel"
  },
  "alumniOf": "Pune University",
  "sameAs": [
    "https://github.com/shindesharad71",
    "https://www.linkedin.com/in/shindesharad71/"
  ],
  "knowsAbout": ["Backend Engineering", "Node.js", "Python", "Ruby", "Go", "System Design", "MongoDB", "MySQL"]
}
</script>
