---
import site from "../data/site.json";
const {journey} = site;

// A drawing's revision block: oldest = Rev A, ascending. Display newest first.
const ascYears = Object.keys(journey).sort((a, b) => Number(a) - Number(b));
const revOf: Record<string, string> = Object.fromEntries(
    ascYears.map((y, i) => [y, String.fromCharCode(65 + i)])
);
const rows = [...ascYears].reverse();
const latest = rows[0];
---
<section id="journey" aria-label="Career journey">
    <div class="section-heading" data-reveal>
        <span class="section-index">03</span>
        <h2>Revision History</h2>
    </div>

    <div class="revtable" data-reveal>
        <div class="rev-head" aria-hidden="true">
            <span>Rev</span>
            <span>Year</span>
            <span>Change</span>
        </div>

        {rows.map((year) => (
            <div class={`rev-row${year === latest ? ' is-current' : ''}`}>
                <div class="rev-meta">
                    <span class="rev-badge">{revOf[year]}</span>
                    <span class="rev-year">{year}</span>
                    {year === latest && <span class="rev-current label">● Current</span>}
                </div>
                <div class="rev-changes">
                    {journey[year].map((item) => (
                        <div class="rev-change">
                            <h3 class="rev-title">{item.title}</h3>
                            <p class="rev-desc">{item.description}</p>
                        </div>
                    ))}
                </div>
            </div>
        ))}
    </div>
</section>
<style>
  .revtable {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    overflow: hidden;
  }

  .rev-head {
    display: grid;
    grid-template-columns: 160px 1fr;
    gap: var(--space-5);
    padding: var(--space-3) var(--space-5);
    background: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: var(--track-label);
    color: var(--paper-faint);
  }
  /* header has 3 spans but 2 columns: fold Rev+Year into first cell */
  .rev-head span:first-child { grid-column: 1; }
  .rev-head span:nth-child(2) { display: none; }

  .rev-row {
    display: grid;
    grid-template-columns: 160px 1fr;
    gap: var(--space-5);
    padding: var(--space-5);
    border-bottom: 1px solid var(--color-border);
    transition: background var(--duration-normal) var(--ease-out);

    &:last-child { border-bottom: 0; }

    &:hover { background: var(--color-surface); }
  }

  .rev-changes { min-width: 0; }

  .rev-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    align-content: flex-start;
  }

  .rev-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: var(--weight-bold);
    color: var(--paper-muted);
    border: 1px solid var(--color-border-hover);
    border-radius: var(--radius-sm);
  }

  .rev-year {
    font-family: var(--font-mono);
    font-size: var(--text-base);
    font-weight: var(--weight-semibold);
    color: var(--paper);
    letter-spacing: 0.02em;
  }

  .rev-current {
    flex-basis: 100%;
    color: var(--redline);
  }

  .is-current .rev-badge {
    color: var(--redline);
    border-color: var(--redline);
    background: var(--color-accent-glow);
  }

  .rev-changes {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .rev-change:not(:last-child) {
    padding-bottom: var(--space-4);
    border-bottom: 1px dashed var(--color-border);
  }

  .rev-title {
    font-size: var(--text-base);
    font-weight: var(--weight-semibold);
    margin-bottom: var(--space-1);
  }

  .rev-desc {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: var(--leading-relaxed);
    margin-bottom: 0;
  }

  @media (max-width: 560px) {
    .rev-head { grid-template-columns: 1fr; }
    .rev-row {
      grid-template-columns: 1fr;
      gap: var(--space-3);
    }
    .rev-meta {
      padding-bottom: var(--space-2);
      border-bottom: 1px dashed var(--color-border);
    }
  }
</style>
