---
const { item, plate } = Astro.props;
---
<article class="work-card card" data-reveal>
    <div class="work-card-image">
        <span class="work-plate">{plate}</span>
        <img src={item.image} alt={item.title} loading="lazy" decoding="async">
    </div>
    <div class="work-card-content">
        <h3 class="work-card-title">{item.title}</h3>
        <p class="work-card-desc">{item.description}</p>
        {item.tech && item.tech.length > 0 &&
            <div class="work-card-tags" aria-label="Stack">
                {item.tech.map(tech => (
                    <span class="tag">{tech}</span>
                ))}
            </div>
        }
        {item.link &&
            <a href={item.link} target="_blank" rel="noopener noreferrer" class="work-card-link">
                Open drawing
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17L17 7"/><path d="M7 7h10v10"/></svg>
            </a>
        }
        {item.info && <p class="work-card-info">{item.info}</p>}
    </div>
</article>
<style>
  .work-card {
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;

    /* redline hairline plotted across the top on hover */
    &::before {
      content: '';
      position: absolute;
      inset: 0 0 auto 0;
      height: 2px;
      background: var(--redline);
      transform: scaleX(0);
      transform-origin: left;
      transition: transform var(--duration-normal) var(--ease-out);
      z-index: 2;
    }

    &:hover,
    &:focus-within {
      &::before { transform: scaleX(1); }

      .work-plate { color: var(--redline); border-color: var(--redline); }

      .work-card-image img {
        transform: scale(1.03);
        filter: none;
      }
      .work-card-image::after { opacity: 0; }

      .work-card-link {
        gap: var(--space-3);
      }
    }
  }

  .work-card-image {
    position: relative;
    overflow: hidden;
    aspect-ratio: 16 / 10;
    background: var(--blueprint-deep);
    border-bottom: 1px solid var(--color-border);

    img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      /* cyanotype duotone by default; full colour on hover */
      filter: grayscale(0.75) contrast(1.05) brightness(0.92);
      transition: transform var(--duration-slow) var(--ease-out),
                  filter var(--duration-slow) var(--ease-out);
    }

    /* blueprint tint overlay */
    &::after {
      content: '';
      position: absolute;
      inset: 0;
      background: var(--blueprint);
      mix-blend-mode: color;
      opacity: 0.5;
      pointer-events: none;
      transition: opacity var(--duration-slow) var(--ease-out);
    }
  }

  .work-plate {
    position: absolute;
    top: var(--space-3);
    left: var(--space-3);
    z-index: 1;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--track-label);
    color: var(--paper-muted);
    background: rgba(9, 29, 54, 0.78);
    border: 1px solid var(--color-border);
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-sm);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    transition: color var(--duration-fast) var(--ease-out),
                border-color var(--duration-fast) var(--ease-out);
  }

  .work-card-content {
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .work-card-title {
    font-size: var(--text-lg);
    font-weight: var(--weight-semibold);
    margin-bottom: var(--space-2);
  }

  .work-card-desc {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: var(--leading-relaxed);
    margin-bottom: var(--space-5);
  }

  .work-card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-5);
    margin-top: auto;
  }

  .tag {
    padding: var(--space-1) var(--space-3);
    background: transparent;
    color: var(--paper-muted);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.03em;
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-border);
  }

  .work-card-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--redline);
    text-decoration: none;
    transition: gap var(--duration-fast) var(--ease-out);

    svg {
      flex-shrink: 0;
    }

    /* stretched link: whole plate is clickable */
    &::after {
      content: '';
      position: absolute;
      inset: 0;
    }
  }

  .work-card-info {
    font-size: var(--text-sm);
    color: var(--color-text-subtle);
    margin-top: var(--space-3);
    margin-bottom: 0;
  }
</style>
