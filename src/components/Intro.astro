---
const currentDate = new Date();
const currentYear = currentDate.getFullYear();
const currentMonth = currentDate.getMonth() + 1;
let years = currentYear - 2017;
let months = currentMonth - 11;

if (months < 0) {
    years--;
    months += 12;
}

const description = `Staff Engineer at HighLevel, specializing in backend architecture, microservices, and system design. Based in Pune, India. Passionate about writing clean code, mentoring developers, and building products that scale to millions of users.`;

const stats = [
    { value: `${years}+`, label: 'Years of experience' },
    { value: 'Millions', label: 'Of users served' },
];
---
<section class="intro" aria-label="Introduction" data-reveal>
    <p class="intro-kicker">Staff Engineer · HighLevel · <span id="typed">backend architecture</span><span class="type-cursor" aria-hidden="true"></span></p>
    <h1>
        Hi, I'm <span class="gradient-text">Sharad</span>.<br />
        I build systems that scale.
    </h1>
    <p class="intro-desc">{description}</p>
    <div class="intro-actions">
        <a href="#work" class="btn btn-primary">
            View my work
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14"/><path d="M19 12l-7 7-7-7"/></svg>
        </a>
        <a href="#footer" class="btn btn-ghost">Get in touch</a>
        <span class="intro-badge">
            <span class="badge-dot"></span>
            Available for collaboration
        </span>
    </div>
    <dl class="intro-stats">
        {stats.map((stat) => (
            <div class="stat">
                <dt class="stat-label">{stat.label}</dt>
                <dd class="stat-value">{stat.value}</dd>
            </div>
        ))}
    </dl>
</section>

<script>
  const typed = document.getElementById('typed');
  const phrases = ['backend architecture', 'distributed systems', 'microservices', 'mentoring engineers'];
  if (typed && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    let phrase = 0;
    let char = phrases[0].length;
    let deleting = true;
    const tick = () => {
      char += deleting ? -1 : 1;
      typed.textContent = phrases[phrase].slice(0, char);
      if (deleting && char === 0) {
        deleting = false;
        phrase = (phrase + 1) % phrases.length;
      } else if (!deleting && char === phrases[phrase].length) {
        deleting = true;
        setTimeout(tick, 2600);
        return;
      }
      setTimeout(tick, deleting ? 40 : 70);
    };
    setTimeout(tick, 2600);
  }
</script>

<style>
  .intro {
    padding-bottom: var(--space-8);
  }

  .intro-kicker {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-accent);
    margin-bottom: var(--space-5);
    letter-spacing: 0.02em;
    min-height: 1.6em; /* reserve the line so retyping never shifts layout */
  }

  .type-cursor {
    display: inline-block;
    width: 1px;
    height: 1.1em;
    margin-left: 2px;
    background: var(--color-accent);
    vertical-align: text-bottom;
    animation: blink 1.1s step-end infinite;
  }

  @keyframes blink {
    50% { opacity: 0; }
  }

  h1 {
    margin-bottom: var(--space-6);
    max-width: 22ch;
  }

  .intro-desc {
    font-size: var(--text-lg);
    color: var(--color-text-muted);
    max-width: 640px;
    line-height: var(--leading-relaxed);
    margin-bottom: var(--space-8);
  }

  .intro-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin-bottom: var(--space-10);
  }

  .intro-badge {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .badge-dot {
    width: 8px;
    height: 8px;
    background: #22c55e;
    border-radius: 50%;
    box-shadow: 0 0 8px rgba(34, 197, 94, 0.6);
    animation: pulse-dot 2s ease-in-out infinite;
  }

  @keyframes pulse-dot {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.4; }
  }

  .intro-stats {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-9);
    padding-top: var(--space-7);
    border-top: 1px solid var(--color-border);
  }

  .stat {
    display: flex;
    flex-direction: column-reverse;
  }

  .stat-value {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: var(--weight-bold);
    letter-spacing: -0.02em;
    color: var(--color-text);
  }

  .stat-label {
    font-size: var(--text-sm);
    color: var(--color-text-subtle);
  }

  @media (max-width: 600px) {
    .intro-stats {
      gap: var(--space-6) var(--space-8);
    }
  }
</style>
