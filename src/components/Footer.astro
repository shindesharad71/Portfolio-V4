---
import site from "../data/site.json";
const {socials, author, profile_pic, resume} = site;
const email = "shindesharad71@gmail.com";
---
<footer id="footer" aria-label="Contact" data-reveal>
    <div class="section-heading">
        <span class="section-index">04</span>
        <h2>Contact — Sign-off</h2>
    </div>
    <div class="footer-panel card">
        <div class="footer-content">
            <div class="footer-main">
                <h3 class="footer-title">Let's build something that <span class="gradient-text">scales</span>.</h3>
                <p class="footer-desc">
                    Open to interesting systems problems, collaborations, and a good conversation about backend architecture. Drop a line.
                </p>
                <div class="footer-actions">
                    <a class="btn btn-primary" href={`mailto:${email}`}>
                        Say hello
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><path d="M22 6l-10 7L2 6"/></svg>
                    </a>
                    <a class="btn btn-ghost" href={resume} target="_blank" rel="noopener noreferrer">View resume</a>
                </div>
                <button class="email-copy" type="button" data-email={email} aria-label="Copy email address">
                    <span class="email-text">{email}</span>
                    <svg class="icon-copy" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"/></svg>
                    <span class="copy-feedback" aria-live="polite"></span>
                </button>
                <div class="footer-socials">
                    {socials.map((social) => (
                        <a
                            href={social.link}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="social-link"
                            aria-label={social.title}
                        >
                            {social.icon === 'github' && (
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                                    <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
                                </svg>
                            )}
                            {social.icon === 'linkedin' && (
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                                    <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                                </svg>
                            )}
                        </a>
                    ))}
                </div>
            </div>
            <figure class="footer-avatar">
                <img width="180" height="180" src={profile_pic} alt={author} loading="lazy" decoding="async" />
                <figcaption class="label">FIG.A — S. Shinde</figcaption>
            </figure>
        </div>
    </div>
    <div class="footer-titleblock">
        <div class="tb-cell">
            <span class="tb-k label">Drawn by</span>
            <span class="tb-v">{author}</span>
        </div>
        <div class="tb-cell">
            <span class="tb-k label">Plotted</span>
            <span class="tb-v" id="local-time">IST · Pune</span>
        </div>
        <div class="tb-cell">
            <span class="tb-k label">Tooling</span>
            <span class="tb-v">Astro · CSS</span>
        </div>
        <div class="tb-cell tb-cell-src">
            <span class="tb-k label">Source</span>
            <a class="tb-v tb-link" href="https://github.com/shindesharad71/Portfolio-V4" target="_blank" rel="noopener noreferrer">View drawing</a>
        </div>
        <p class="footer-copy">&copy; {new Date().getFullYear()} {author}</p>
    </div>
</footer>

<script>
  // Copy email to clipboard
  const copyBtn = document.querySelector<HTMLButtonElement>('.email-copy');
  copyBtn?.addEventListener('click', async () => {
    const feedback = copyBtn.querySelector('.copy-feedback');
    try {
      await navigator.clipboard.writeText(copyBtn.dataset.email ?? '');
      if (feedback) feedback.textContent = 'Copied ✓';
    } catch {
      if (feedback) feedback.textContent = 'Press ⌘C';
    }
    setTimeout(() => { if (feedback) feedback.textContent = ''; }, 2000);
  });

  // Plot timestamp (IST)
  const timeEl = document.getElementById('local-time');
  const renderTime = () => {
    if (!timeEl) return;
    const ist = new Date().toLocaleTimeString('en-IN', {
      hour: '2-digit', minute: '2-digit', hour12: false, timeZone: 'Asia/Kolkata',
    });
    timeEl.textContent = `${ist} IST · Pune`;
  };
  renderTime();
  setInterval(renderTime, 30_000);
</script>

<style>
  footer {
    margin-bottom: var(--space-10);
  }

  .footer-panel {
    padding: var(--space-9);
    margin-bottom: var(--space-5);
  }

  .footer-content {
    display: flex;
    align-items: center;
    gap: var(--space-10);
  }

  .footer-main {
    flex: 1;
    min-width: 0;
  }

  .footer-title {
    font-size: var(--text-3xl);
    font-weight: var(--weight-bold);
    margin-bottom: var(--space-4);
    max-width: 18ch;
  }

  .footer-desc {
    font-size: var(--text-base);
    color: var(--color-text-muted);
    margin-bottom: var(--space-6);
    max-width: 46ch;
  }

  .footer-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-bottom: var(--space-6);
  }

  .email-copy {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    background: none;
    border: none;
    padding: 0;
    margin-bottom: var(--space-6);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    cursor: pointer;
    transition: color var(--duration-fast) var(--ease-out);

    &:hover,
    &:focus-visible {
      color: var(--redline);
    }
  }

  .email-text {
    border-bottom: 1px dashed var(--color-border-hover);
    padding-bottom: 1px;
  }

  .copy-feedback {
    color: var(--redline);
    font-size: var(--text-xs);
  }

  .footer-socials {
    display: flex;
    gap: var(--space-3);
  }

  .social-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    background: transparent;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    color: var(--color-text-muted);
    transition: color var(--duration-normal) var(--ease-out),
                border-color var(--duration-normal) var(--ease-out);

    &:hover,
    &:focus-visible {
      color: var(--redline);
      border-color: var(--redline);
    }
  }

  .footer-avatar {
    flex-shrink: 0;
    margin: 0;
    text-align: center;

    img {
      width: 170px;
      height: 170px;
      border-radius: var(--radius-sm);
      object-fit: cover;
      border: 1px solid var(--color-border-hover);
      filter: grayscale(0.7) contrast(1.04) brightness(0.95);
      transition: filter var(--duration-slow) var(--ease-out);
    }

    &:hover img { filter: none; }

    figcaption {
      margin-top: var(--space-2);
    }
  }

  /* Title block — the drawing's sign-off strip */
  .footer-titleblock {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
  }

  .tb-cell {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding: var(--space-4) var(--space-5);
    border-right: 1px solid var(--color-border);
  }
  .tb-cell:last-of-type { border-right: 0; }

  .tb-v {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--paper);
    letter-spacing: 0.02em;
  }

  .tb-link:hover { color: var(--redline); }

  .footer-copy {
    grid-column: 1 / -1;
    margin: 0;
    padding: var(--space-3) var(--space-5);
    border-top: 1px solid var(--color-border);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--paper-faint);
    letter-spacing: 0.04em;
  }

  @media (max-width: 600px) {
    .footer-panel {
      padding: var(--space-7) var(--space-6);
    }

    .footer-content {
      flex-direction: column-reverse;
      gap: var(--space-7);
      text-align: center;
    }

    .footer-title { max-width: none; }

    .footer-avatar img {
      width: 140px;
      height: 140px;
    }

    .footer-actions,
    .footer-socials {
      justify-content: center;
    }

    .footer-titleblock {
      grid-template-columns: repeat(2, 1fr);
    }
    .tb-cell:nth-child(2) { border-right: 0; }
    .tb-cell:nth-child(1),
    .tb-cell:nth-child(2) { border-bottom: 1px solid var(--color-border); }
  }
</style>
